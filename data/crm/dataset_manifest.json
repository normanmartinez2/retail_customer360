  "business_conventions": {
    "currency": "EUR; other values are intentional data-quality tests",
    "timestamps": "ISO-8601 UTC; malformed values intentionally included",
    "order_total_formula": "subtotal_eur - discount_eur + shipping_eur; subtotal_eur = sum(item line_total_eur) before intentional item mutations",
    "line_total_formula": "quantity * unit_price_eur - line_discount_eur, before intentional item mutations",
    "payment_amount": "Positive for CHARGE, negative for REFUND; payment_status determines whether an event is settled",
    "order_customer_fk": "Orders reference CRM customer_id, sometimes intentionally invalid/missing/unknown",
    "items_orders_fk": "order_items.order_id -> orders.order_id; some intentionally unknown",
    "items_products_fk": "order_items.product_id -> products.product_id; some intentionally unknown",
    "payments_orders_fk": "payments.order_id -> orders.order_id; some intentionally unknown",
    "interactions_customers_fk": "customer_interactions.customer_id -> CRM customer_id; some intentionally unknown",
    "cdc_null_semantics": "For CDC UPDATE records, an empty new_* field means NO CHANGE. INSERT rows contain full attributes. DELETE is a tombstone.",
    "cdc_replays": "Same event_id appears multiple times intentionally; de-duplicate by event_id before MERGE",
    "cdc_out_of_order": "Some source_sequence=0 events arrive after sequence=1; order by source sequence/event timestamp, do not overwrite newer states"
  },
